#
# Damavik dashboard: serves the JSON API and the static UI on 127.0.0.1.
#
# This unit used to be `damavik-brain.service`, running `damavik run` with
# StandardInput=null.  A brain with no input reads EOF, ingests nothing, exits
# 0, and a Type=simple unit with Restart=on-failure is then simply inactive -
# so the packaged install monitored nothing while claiming otherwise.  The
# scoring half of the brain lives in damavik-sensor.service (sensor | run);
# a separate brain reading a socket/FIFO instead of a pipe arrives with the
# eBPF sensor in P1.
#
# The dashboard is optional: `systemctl stop damavik-dashboard` leaves the
# journal and the index intact.

[Unit]
Description=Damavik dashboard - local threat monitor on 127.0.0.1
After=network.target

[Service]
Type=simple
Environment=DAMAVIK_STATE_DIR=/var/lib/damavik
Environment=DAMAVIK_RULES_DIR=/usr/share/damavik/rules
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/damavik serve --config /etc/damavik/damavik.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

# --- hardening -------------------------------------------------------------
# A monitor that can be trivially tampered with is worse than none, so the
# dashboard gets the tightest profile that still lets it read its own index.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Only its own state directory is writable.  The dashboard opens the index
# read-mostly, but SQLite needs the directory to exist and be writable.
ReadWritePaths=/var/lib/damavik

# Resource caps: brain RSS budget is 150 MB. A runaway brain is killed here
# rather than dragging the machine down with it.
MemoryMax=256M
TasksMax=64
CPUQuota=100%

[Install]
WantedBy=multi-user.target
