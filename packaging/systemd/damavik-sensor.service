#
# Damavik sensor: emits newline-delimited JSON events on stdout and pipes them
# into the brain.
#
# Deployment shape (P0): this unit is the whole monitor.  It runs
# `damavik sensor | damavik run`, so the sensor's JSONL goes straight into the
# scorer with no IPC surface to secure, and one service restart restarts both
# halves.  The split shape - sensor writing to a socket/FIFO, brain reading it,
# `damavik serve` serving the UI - arrives with the eBPF sensor in P1, because
# only then is there a reason to upgrade the two halves separately.
#
# The sensor is the part that needs privilege: reading /proc across users,
# fanotify and eBPF all require root or CAP_SYS_ADMIN. The brain does not.

[Unit]
Description=Damavik monitor - process, flow and DNS events
After=local-fs.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=DAMAVIK_STATE_DIR=/var/lib/damavik
Environment=DAMAVIK_RULES_DIR=/usr/share/damavik/rules
ExecStart=/bin/sh -c '/usr/local/bin/damavik sensor --interval 2 | /usr/local/bin/damavik run --config /etc/damavik/damavik.yaml'
Restart=always
RestartSec=5s
TimeoutStopSec=20s

# No WatchdogSec here.  systemd's watchdog requires the service to send
# `WATCHDOG=1` on $NOTIFY_SOCKET, and neither the sensor nor the brain speaks
# sd_notify - so arming it did not detect a hung sensor, it killed a healthy one
# every two minutes and restarted the pipe (a self-inflicted gap in the journal
# every 120 s).  Restart=always already covers a crash; a real liveness signal
# means teaching the sensor sd_notify, which is P1 work alongside the eBPF
# sensor.  Until then, staleness is visible where it belongs: the brain records
# a sensor.meta heartbeat break when the stream stops.

# --- hardening -------------------------------------------------------------
# Deliberately weaker than the brain: the sensor legitimately reads /proc for
# all users. It still gets no network, no home directory and no writable paths
# except the state directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=no
ProtectKernelModules=no
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/damavik

# Sensor budget: RAM < 50 MB.
MemoryMax=96M
TasksMax=32
CPUQuota=50%

# P1: the eBPF sensor additionally needs CAP_BPF/CAP_PERFMON (or CAP_SYS_ADMIN
# on kernels < 5.8) and access to /sys/kernel/btf/vmlinux. When that lands,
# drop ProtectKernelTunables=no is kept and add:
#   AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE
#   CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
